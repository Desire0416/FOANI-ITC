# ==========================================================================
# FOANI-ITC — variables d'environnement
# Copier en `.env.local` et renseigner. Aucune valeur secrète ne figure ici.
# ==========================================================================

# Adresse publique du portail. Sert aux URL canoniques, au plan du site,
# au fichier robots et aux données structurées.
NEXT_PUBLIC_APP_URL=https://www.foani-itc.ci

# --------------------------------------------------------------------------
# Secret de session — CDC §21.3
# Chaîne aléatoire de 64 caractères. À générer une fois, par environnement :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# --------------------------------------------------------------------------
PAYLOAD_SECRET=

# --------------------------------------------------------------------------
# Base de données — CDC §22.1
#
# `DATABASE_URL` désigne un serveur PostgreSQL. Sans elle, le dispositif
# retombe sur un fichier SQLite local (`DATABASE_URI`), ce qui permet de
# travailler hors ligne.
#
# `DATABASE_URL_UNPOOLED` est la connexion directe, sans pool. Elle n'est
# utile qu'aux scripts qui modifient le schéma : un pool de connexions ne
# supporte pas les instructions de migration.
# --------------------------------------------------------------------------
DATABASE_URL=
DATABASE_URL_UNPOOLED=
DATABASE_URI=

# Application du schéma à la base.
#
# Laisser VIDE. Payload n'aligne alors pas la base sur les collections au
# démarrage — un rapprochement rejoué à chaque démarrage à froid renvoie des
# `ALTER TABLE` par la connexion poolée, qui les refuse : quatre-vingts
# secondes d'attente, puis une erreur.
#
# Pour poser ou faire évoluer le schéma, une fois, par la connexion directe :
#     DATABASE_URL="$DATABASE_URL_UNPOOLED" PAYLOAD_DB_PUSH=1 pnpm amorcer
PAYLOAD_DB_PUSH=

# --------------------------------------------------------------------------
# Réception des demandes issues du site (information, brochure, devis,
# recrutement, presse).
#
# Tant que cette variable est vide, les formulaires le disent explicitement à
# l'utilisateur au lieu d'afficher une fausse confirmation. Renseigner
# l'adresse du service qui tient la liste de prospects (CDC §10.6) : elle doit
# accepter un POST JSON.
# --------------------------------------------------------------------------
PROSPECTS_WEBHOOK_URL=

# --------------------------------------------------------------------------
# Services numériques — CDC §7.2
#
# Chaque carte de la page « Espace numérique » n'affiche un lien que si son
# adresse est renseignée. Sans adresse, elle annonce « bientôt disponible »
# plutôt que de renvoyer vers une page morte : c'est précisément ce que
# l'audit reprochait au dispositif précédent.
# --------------------------------------------------------------------------
NEXT_PUBLIC_ESPACE_ETUDIANT_URL=
NEXT_PUBLIC_MOODLE_URL=
NEXT_PUBLIC_MESSAGERIE_URL=

# --------------------------------------------------------------------------
# Tâches planifiées — RG-45
#
# Secret protégeant /api/taches/echeances, qui constate les désistements dont
# le délai d'acceptation est expiré. Sans lui, l'adresse refuse tout : mieux
# vaut une tâche qui ne tourne pas qu'une adresse ouverte capable de faire
# basculer des dossiers.
#
# Sur Vercel, déclarer la planification dans vercel.json :
#   { "crons": [{ "path": "/api/taches/echeances", "schedule": "0 6 * * *" }] }
# --------------------------------------------------------------------------
TACHES_SECRET=

# --- Mesure d'audience (§19.1, §20.2) -------------------------------------
# Vide = aucune mesure, aucun domaine tiers appelé, aucun bandeau.
# 'plausible' et 'umami' ne déposent aucun traceur : pas de consentement requis.
# 'matomo' dépose un traceur : le bandeau de consentement s'active seul.
NEXT_PUBLIC_AUDIENCE_OUTIL=
NEXT_PUBLIC_AUDIENCE_SITE=
NEXT_PUBLIC_AUDIENCE_SCRIPT=

# --------------------------------------------------------------------------
# Stockage des pièces justificatives — CDC §20.2 et §22.1
#
# Trois cas, dans cet ordre de priorité :
#   1. Vercel Blob — `BLOB_READ_WRITE_TOKEN` est posé automatiquement par la
#      plateforme une fois le magasin connecté au projet ;
#   2. un espace compatible S3, si les quatre variables sont renseignées ;
#   3. à défaut, le disque local — hors du dossier public, servi par Payload
#      seul, sous contrôle d'accès.
#
# Dans tous les cas, une pièce d'identité n'a jamais d'adresse devinable.
# --------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=

S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
